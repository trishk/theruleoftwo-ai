// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id
  email     String?
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  memberships   ConversationMember[]
  integrations  UserIntegration[]
  readStates    ConversationReadState[]
  requestedGenerations AiGeneration[]        @relation("GenerationRequester")
  generationAttempts  AiGenerationAttempt[] @relation("AttemptRequester")
}

model UserIntegration {
  id              Int      @id @default(autoincrement())
  userId          String
  provider        String
  selectedModel   String
  encryptedApiKey String?
  keyIv           String?
  keyAuthTag      String?
  storageMode     String   @default("persistent")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id                 Int      @id @default(autoincrement())
  publicId           String   @unique @default(cuid())
  title              String
  ownerId            String
  allowMemberAiUsage Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner      User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members    ConversationMember[]
  invites    ConversationInvite[]
  messages   Message[]
  readStates ConversationReadState[]
  aiGenerations AiGeneration[]
}

model ConversationMember {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ConversationReadState {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ConversationInvite {
  id             Int       @id @default(autoincrement())
  conversationId Int
  token          String    @unique
  createdById    String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  usageCount     Int       @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  authorType     String
  authorId       String
  content        String
  replyToId      Int?
  clientMessageId   String?
  clientPayloadHash String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")
  sourceGenerations AiGeneration[]
  generationAttempt AiGenerationAttempt? @relation("AttemptOutput")

  @@unique([conversationId, authorId, clientMessageId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model AiGeneration {
  id                 String   @id
  conversationId     Int
  sourceMessageId    Int
  provider           String
  initialRequesterId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversation     Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage    Message               @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  initialRequester User                  @relation("GenerationRequester", fields: [initialRequesterId], references: [id], onDelete: Cascade)
  attempts         AiGenerationAttempt[]

  @@unique([sourceMessageId, provider])
  @@index([conversationId])
}

model AiGenerationAttempt {
  id                String    @id
  generationId      String
  attemptNumber     Int
  retryOfId         String?   @unique
  requesterId       String
  status            String
  outputMessageId   Int?      @unique
  errorCode         String?
  reservedAt        DateTime  @default(now())
  startedAt         DateTime?
  providerInvokedAt DateTime?
  progressAt        DateTime  @default(now())
  completedAt       DateTime?
  failedAt          DateTime?
  stoppedAt         DateTime?

  generation   AiGeneration        @relation(fields: [generationId], references: [id], onDelete: Cascade)
  requester    User                @relation("AttemptRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  outputMessage Message?           @relation("AttemptOutput", fields: [outputMessageId], references: [id], onDelete: SetNull)
  retryOf      AiGenerationAttempt? @relation("AttemptRetry", fields: [retryOfId], references: [id], onDelete: NoAction)
  retriedBy    AiGenerationAttempt? @relation("AttemptRetry")

  @@unique([generationId, attemptNumber])
  @@index([status, progressAt])
}

model RateLimitBucket {
  id          Int      @id @default(autoincrement())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([windowStart])
}

model LLMGenerationLease {
  id        Int      @id @default(autoincrement())
  userId    String
  slot      Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, slot])
  @@index([expiresAt])
}
